<?xml version="1.0"?>
<sdf version="1.6">
  <world name="human_tracking_world">
    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <model name="tracking_subject">
      <static>false</static>
      <pose>1.8 0.0 0.06 0 0 0</pose>
      <link name="base">
        <visual name="base_visual">
          <pose>0 0 0.035 0 0 0</pose>
          <geometry>
            <box>
              <size>0.32 0.24 0.07</size>
            </box>
          </geometry>
          <material>
            <ambient>0.0 0.35 0.05 1</ambient>
            <diffuse>0.0 0.45 0.08 1</diffuse>
          </material>
        </visual>
        <visual name="torso_visual">
          <pose>0 0 0.43 0 0 0</pose>
          <geometry>
            <box>
              <size>0.28 0.16 0.72</size>
            </box>
          </geometry>
          <material>
            <ambient>0.0 0.8 0.1 1</ambient>
            <diffuse>0.0 0.9 0.1 1</diffuse>
          </material>
        </visual>
        <visual name="head_visual">
          <pose>0 0 0.91 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.13</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.0 0.8 0.1 1</ambient>
            <diffuse>0.0 0.9 0.1 1</diffuse>
          </material>
        </visual>
        <visual name="left_wheel_visual">
          <pose>0 0.16 0.06 1.5708 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.055</radius>
              <length>0.035</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.02 0.02 0.02 1</ambient>
            <diffuse>0.02 0.02 0.02 1</diffuse>
          </material>
        </visual>
        <visual name="right_wheel_visual">
          <pose>0 -0.16 0.06 1.5708 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.055</radius>
              <length>0.035</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.02 0.02 0.02 1</ambient>
            <diffuse>0.02 0.02 0.02 1</diffuse>
          </material>
        </visual>
        <inertial>
          <mass>2.0</mass>
          <inertia>
            <ixx>0.06</ixx>
            <iyy>0.06</iyy>
            <izz>0.04</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
      </link>

      <link name="left_wheel">
        <pose>0 0.16 0.06 1.5708 0 0</pose>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.055</radius>
              <length>0.035</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100.0</mu>
                <mu2>50.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <inertial>
          <mass>0.12</mass>
          <inertia>
            <ixx>0.0002</ixx>
            <iyy>0.0002</iyy>
            <izz>0.0002</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
      </link>

      <link name="right_wheel">
        <pose>0 -0.16 0.06 1.5708 0 0</pose>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.055</radius>
              <length>0.035</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100.0</mu>
                <mu2>50.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <inertial>
          <mass>0.12</mass>
          <inertia>
            <ixx>0.0002</ixx>
            <iyy>0.0002</iyy>
            <izz>0.0002</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
      </link>

      <joint name="left_wheel_joint" type="revolute">
        <parent>base</parent>
        <child>left_wheel</child>
        <axis>
          <xyz>0 1 0</xyz>
          <use_parent_model_frame>true</use_parent_model_frame>
          <limit>
            <lower>-1e16</lower>
            <upper>1e16</upper>
          </limit>
        </axis>
      </joint>

      <joint name="right_wheel_joint" type="revolute">
        <parent>base</parent>
        <child>right_wheel</child>
        <axis>
          <xyz>0 1 0</xyz>
          <use_parent_model_frame>true</use_parent_model_frame>
          <limit>
            <lower>-1e16</lower>
            <upper>1e16</upper>
          </limit>
        </axis>
      </joint>

      <plugin name="tracking_subject_diff_drive" filename="libgazebo_ros_diff_drive.so">
        <ros>
          <namespace>/tracking_subject</namespace>
          <remapping>cmd_vel:=cmd_vel</remapping>
        </ros>
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.32</wheel_separation>
        <wheel_diameter>0.11</wheel_diameter>
        <max_wheel_torque>20.0</max_wheel_torque>
        <max_wheel_acceleration>8.0</max_wheel_acceleration>
        <command_topic>cmd_vel</command_topic>
        <odometry_topic>odom</odometry_topic>
        <odometry_frame>tracking_subject_odom</odometry_frame>
        <robot_base_frame>base</robot_base_frame>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>false</publish_odom_tf>
        <publish_wheel_tf>false</publish_wheel_tf>
        <update_rate>50</update_rate>
      </plugin>
    </model>


    <model name="red_cylinder_obstacle">
      <static>true</static>
      <pose>0.95 -0.85 0.30 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.28</radius>
              <length>0.60</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.28</radius>
              <length>0.60</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.85 0.12 0.05 1</ambient>
            <diffuse>0.95 0.18 0.08 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="blue_box_obstacle">
      <static>true</static>
      <pose>1.80 0.85 0.30 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.50 0.50 0.60</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.50 0.50 0.60</size>
            </box>
          </geometry>
          <material>
            <ambient>0.05 0.18 0.75 1</ambient>
            <diffuse>0.08 0.25 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>30.0</update_rate>
    </plugin>
  </world>
</sdf>
