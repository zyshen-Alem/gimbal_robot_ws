<?xml version="1.0"?>
<sdf version="1.6">
  <world name="human_tracking_world">
    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <model name="tracking_subject">
      <static>false</static>
      <pose>1.8 0.0 0.06 0 0 0</pose>
      <link name="base">
        <visual name="base_visual">
          <pose>0 0 0.025 0 0 0</pose>
          <geometry>
            <box>
              <size>0.30 0.22 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.03 0.03 0.03 1</ambient>
            <diffuse>0.04 0.04 0.04 1</diffuse>
          </material>
        </visual>
        <visual name="left_leg_visual">
          <pose>0 0.07 0.34 0 0 0</pose>
          <geometry>
            <box>
              <size>0.09 0.08 0.56</size>
            </box>
          </geometry>
          <material>
            <ambient>0.03 0.05 0.22 1</ambient>
            <diffuse>0.05 0.08 0.36 1</diffuse>
          </material>
        </visual>
        <visual name="right_leg_visual">
          <pose>0 -0.07 0.34 0 0 0</pose>
          <geometry>
            <box>
              <size>0.09 0.08 0.56</size>
            </box>
          </geometry>
          <material>
            <ambient>0.03 0.05 0.22 1</ambient>
            <diffuse>0.05 0.08 0.36 1</diffuse>
          </material>
        </visual>
        <visual name="torso_visual">
          <pose>0 0 0.91 0 0 0</pose>
          <geometry>
            <box>
              <size>0.18 0.36 0.58</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.05 0.05 1</ambient>
            <diffuse>0.80 0.08 0.08 1</diffuse>
          </material>
        </visual>
        <visual name="left_arm_visual">
          <pose>0 0.25 0.90 0 0 0</pose>
          <geometry>
            <box>
              <size>0.07 0.08 0.52</size>
            </box>
          </geometry>
          <material>
            <ambient>0.72 0.48 0.32 1</ambient>
            <diffuse>0.95 0.65 0.42 1</diffuse>
          </material>
        </visual>
        <visual name="right_arm_visual">
          <pose>0 -0.25 0.90 0 0 0</pose>
          <geometry>
            <box>
              <size>0.07 0.08 0.52</size>
            </box>
          </geometry>
          <material>
            <ambient>0.72 0.48 0.32 1</ambient>
            <diffuse>0.95 0.65 0.42 1</diffuse>
          </material>
        </visual>
        <visual name="neck_visual">
          <pose>0 0 1.24 0 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.045</radius>
              <length>0.10</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.72 0.48 0.32 1</ambient>
            <diffuse>0.95 0.65 0.42 1</diffuse>
          </material>
        </visual>
        <visual name="head_visual">
          <pose>0 0 1.40 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.14</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.72 0.48 0.32 1</ambient>
            <diffuse>0.95 0.65 0.42 1</diffuse>
          </material>
        </visual>
        <visual name="hair_visual">
          <pose>0 0 1.51 0 0 0</pose>
          <geometry>
            <sphere>
              <radius>0.115</radius>
            </sphere>
          </geometry>
          <material>
            <ambient>0.02 0.015 0.01 1</ambient>
            <diffuse>0.04 0.03 0.02 1</diffuse>
          </material>
        </visual>
        <visual name="left_wheel_visual">
          <pose>0 0.16 0.06 1.5708 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.055</radius>
              <length>0.035</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.01 0.01 0.01 0.25</ambient>
            <diffuse>0.01 0.01 0.01 0.25</diffuse>
          </material>
        </visual>
        <visual name="right_wheel_visual">
          <pose>0 -0.16 0.06 1.5708 0 0</pose>
          <geometry>
            <cylinder>
              <radius>0.055</radius>
              <length>0.035</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.01 0.01 0.01 0.25</ambient>
            <diffuse>0.01 0.01 0.01 0.25</diffuse>
          </material>
        </visual>
        <inertial>
          <mass>2.0</mass>
          <inertia>
            <ixx>0.06</ixx>
            <iyy>0.06</iyy>
            <izz>0.04</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
      </link>

      <link name="left_wheel">
        <pose>0 0.16 0.06 1.5708 0 0</pose>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.055</radius>
              <length>0.035</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>2.0</mu>
                <mu2>2.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <inertial>
          <mass>0.12</mass>
          <inertia>
            <ixx>0.0002</ixx>
            <iyy>0.0002</iyy>
            <izz>0.0002</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
      </link>

      <link name="right_wheel">
        <pose>0 -0.16 0.06 1.5708 0 0</pose>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.055</radius>
              <length>0.035</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>2.0</mu>
                <mu2>2.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <inertial>
          <mass>0.12</mass>
          <inertia>
            <ixx>0.0002</ixx>
            <iyy>0.0002</iyy>
            <izz>0.0002</izz>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyz>0</iyz>
          </inertia>
        </inertial>
      </link>

      <joint name="left_wheel_joint" type="revolute">
        <parent>base</parent>
        <child>left_wheel</child>
        <axis>
          <xyz>0 1 0</xyz>
          <use_parent_model_frame>true</use_parent_model_frame>
          <limit>
            <lower>-1e16</lower>
            <upper>1e16</upper>
          </limit>
        </axis>
      </joint>

      <joint name="right_wheel_joint" type="revolute">
        <parent>base</parent>
        <child>right_wheel</child>
        <axis>
          <xyz>0 1 0</xyz>
          <use_parent_model_frame>true</use_parent_model_frame>
          <limit>
            <lower>-1e16</lower>
            <upper>1e16</upper>
          </limit>
        </axis>
      </joint>

      <plugin name="tracking_subject_diff_drive" filename="libgazebo_ros_diff_drive.so">
        <ros>
          <remapping>cmd_vel:=/tracking_subject/cmd_vel</remapping>
          <remapping>odom:=/tracking_subject/odom</remapping>
        </ros>
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.32</wheel_separation>
        <wheel_diameter>0.11</wheel_diameter>
        <max_wheel_torque>20.0</max_wheel_torque>
        <max_wheel_acceleration>8.0</max_wheel_acceleration>
        <command_topic>/tracking_subject/cmd_vel</command_topic>
        <odometry_topic>/tracking_subject/odom</odometry_topic>
        <odometry_frame>tracking_subject_odom</odometry_frame>
        <robot_base_frame>base</robot_base_frame>
        <publish_odom>true</publish_odom>
        <publish_odom_tf>false</publish_odom_tf>
        <publish_wheel_tf>false</publish_wheel_tf>
        <update_rate>50</update_rate>
      </plugin>
    </model>

    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>30.0</update_rate>
    </plugin>
  </world>
</sdf>
