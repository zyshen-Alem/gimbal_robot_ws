<?xml version="1.0"?>
<sdf version="1.6">
  <world name="yolo_actor_following_world">
    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://ground_plane</uri>
    </include>

    <actor name="tracking_subject">
      <pose>2.8 0.0 0.0 0 0 3.14159</pose>
      <skin>
        <filename>walk.dae</filename>
        <scale>0.85</scale>
      </skin>
      <animation name="walking">
        <filename>walk.dae</filename>
        <scale>0.85</scale>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>false</loop>
        <delay_start>1.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walking">
          <waypoint>
            <time>0.0</time>
            <pose>2.8 0.0 0.0 0 0 3.14159</pose>
          </waypoint>
          <waypoint>
            <time>5.0</time>
            <pose>3.5 0.0 0.0 0 0 3.14159</pose>
          </waypoint>
          <waypoint>
            <time>10.0</time>
            <pose>4.4 0.0 0.0 0 0 3.14159</pose>
          </waypoint>
          <waypoint>
            <time>15.0</time>
            <pose>5.2 0.0 0.0 0 0 3.14159</pose>
          </waypoint>
          <waypoint>
            <time>20.0</time>
            <pose>6.0 0.0 0.0 0 0 3.14159</pose>
          </waypoint>
          <waypoint>
            <time>25.0</time>
            <pose>7.9 0.0 0.0 0 0 3.14159</pose>
          </waypoint>
          <waypoint>
            <time>32.0</time>
            <pose>8.5 0.90 0.0 0 0 2.20</pose>
          </waypoint>
          <waypoint>
            <time>37.0</time>
            <pose>9.4 0.90 0.0 0 0 3.14159</pose>
          </waypoint>
          <waypoint>
            <time>45.0</time>
            <pose>10.0 0.0 0.0 0 0 -2.20</pose>
          </waypoint>
          <waypoint>
            <time>55.0</time>
            <pose>11.2 0.0 0.0 0 0 3.14159</pose>
          </waypoint>
          <waypoint>
            <time>65.0</time>
            <pose>12.8 0.0 0.0 0 0 3.14159</pose>
          </waypoint>
        </trajectory>
      </script>
    </actor>

    <model name="left_gate_obstacle">
      <static>true</static>
      <pose>3.75 0.43 0.30 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.24</radius>
              <length>0.60</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.24</radius>
              <length>0.60</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.85 0.05 0.04 1</ambient>
            <diffuse>0.85 0.05 0.04 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="right_gate_obstacle">
      <static>true</static>
      <pose>3.75 -0.43 0.30 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.24</radius>
              <length>0.60</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.24</radius>
              <length>0.60</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.05 0.20 0.90 1</ambient>
            <diffuse>0.05 0.20 0.90 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="rear_green_box_obstacle">
      <static>true</static>
      <pose>8.8 0.0 0.30 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.55 0.55 0.60</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.55 0.55 0.60</size>
            </box>
          </geometry>
          <material>
            <ambient>0.05 0.75 0.12 1</ambient>
            <diffuse>0.05 0.75 0.12 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>30.0</update_rate>
    </plugin>
  </world>
</sdf>